# Copy this file to .env or .env.local and update the values below.
# .env.local is Git-ignored and is the recommended place for real secrets.
# If you rec'd this via a Planet Engineer, rename rename-me.env to just .env

# Required values for service principal authentication
ClientId=
TenantId=
# SharePoint tenant name (prefix for *.sharepoint.com / *.sharepoint.us)
SPTenantName=
# AAD/Entra tenant name (prefix for *.onmicrosoft.com / *.onmicrosoft.us)
AADTenantName=
CertificateThumbprint=
# Allowed values: Commercial | GCCH
# Allowed values: GCC covered by Commercial
CloudEnvironment=Commercial
